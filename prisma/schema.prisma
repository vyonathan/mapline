// This file is part of the Mapline Prisma schema.
// Generated by `npx prisma migrate dev` — do not edit manually.
// Run `npx prisma migrate dev` to update the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------
// Main user record (linked to Clerk auth)
// -------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique
  email         String?
  name          String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  preferences   UserPreference[]
  savedStations SavedStation[]
  savedLines    SavedLine[]
  savedJourneys SavedJourney[]
}

// -------------------------------------------------------------------
// User preferences table (key-value settings)
// -------------------------------------------------------------------
model UserPreference {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key     String
  value   String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// -------------------------------------------------------------------
// Saved station (user-owned)
// -------------------------------------------------------------------
model SavedStation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stationId  String
  station    RailwayStation? @relation(fields: [stationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, stationId])
}

// -------------------------------------------------------------------
// Saved railway line (user-owned)
// -------------------------------------------------------------------
model SavedLine {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineId     String
  line       RailwayLine? @relation(fields: [lineId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, lineId])
}

// -------------------------------------------------------------------
// Saved railway journey (user-owned)
// -------------------------------------------------------------------
model SavedJourney {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  originId   String
  destinationId String
  route      String   // JSON-encoded route (steps, path, stationSequence, etc.)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name])
}

// -------------------------------------------------------------------
// Application settings (single-row key-value store)
// -------------------------------------------------------------------
model Settings {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------------
// Railway station (shared reference data — imported from version-controlled dataset)
// -------------------------------------------------------------------
model RailwayStation {
  id        String @id
  name      String
  coords    String
  region    String
  interchange Boolean
  lines     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  savedStations SavedStation[]
}

// -------------------------------------------------------------------
// Railway line (shared reference data — imported from version-controlled dataset)
// -------------------------------------------------------------------
model RailwayLine {
  id          String @id
  name        String
  shortName   String
  category    String
  color       String
  region      String
  operator    String
  headway     String
  sequences   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  savedLines  SavedLine[]
}
