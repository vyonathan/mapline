# Mapline — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.

# --- Next.js (runtime) ---

# Application URL (needed for Clerk proxy / cookie settings)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (authentication) ---
# Public publishable key (safe to expose in browser code)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk test / local API key (server-side only — never committed to source)
CLERK_SECRET_KEY=

# --- PostgreSQL (database) ---
# Connection string for local Postgres (Docker Compose default: postgresql://mapline:mapline@localhost:5432/mapline)
DATABASE_URL=postgresql://mapline:mapline@localhost:5432/mapline?schema=public

# --- Optional: external map tile rate limiting (no keys required for stock tiles) ---
# Basemap tile cache key (no secret; used for shared heavy tile loads)
NEXT_PUBLIC_MAP_TILE_DIMENSION=512

# --- Optional: simulation clock sync ---
# ESTABLISHED: WIB (UTC+7) is hard-coded in simulation/clock.js; no env needed.

# --- Optional: third-party (do not set unless you have credentials) ---
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
